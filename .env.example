YUNQI_USERNAME=
YUNQI_PASSWORD=

# Use English commas to search multiple keywords in one run.
YUNQI_KEYWORD="keyword one, keyword two"
DAILY_MIN=30
MONTHLY_MIN=1000
HOVER_IMAGE_WAIT_MS=3000

# Optional Temu category filters.
# Leave both empty to skip category filtering.
# Set only parent to select the whole parent category.
# Set children with English commas to select specific subcategories under the parent.
YUNQI_CATEGORY_PARENT=
YUNQI_CATEGORY_CHILDREN=

# Put your Excel template at templates/选品表格-模板.xlsx, or set an absolute path here.
EXCEL_TEMPLATE=templates/选品表格-模板.xlsx

# Optional output directory. Relative paths are resolved inside the script folder you run.
# Use an absolute path if you want all scripts to output to the same folder.
# OUTPUT_DIR=/absolute/path/to/yunqi-outputs

# 0 = show browser, 1 = headless browser
HEADLESS=0

# Optional overrides
# NODE=node
# PYTHON=python3

# Browser note:
# By default, scripts use Playwright's bundled Chromium.
# Install it with: npx playwright install chromium
# Only set CHROME_PATH if bundled Chromium does not work or you want to force local Chrome.

# macOS Chrome example:
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Windows Chrome example:
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# USER_DATA_DIR=/tmp/yunqi-chrome-profile
