YUNQI_USERNAME=
YUNQI_PASSWORD=

YUNQI_KEYWORD="pop up greeting card"
DAILY_MIN=30
MONTHLY_MIN=1000

# Put your Excel template at templates/选品表格-模板.xlsx, or set an absolute path here.
EXCEL_TEMPLATE=templates/选品表格-模板.xlsx

# Optional output directory. Relative paths are resolved inside the script folder you run.
# Use an absolute path if you want all scripts to output to the same folder.
# OUTPUT_DIR=/absolute/path/to/yunqi-outputs

# 0 = show browser, 1 = headless browser
HEADLESS=0

# Optional overrides
# NODE=node
# PYTHON=python3

# macOS Chrome example:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows Chrome example:
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# USER_DATA_DIR=/tmp/yunqi-chrome-profile
